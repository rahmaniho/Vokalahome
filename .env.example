# ─────────────────────────────────────────────────────────────────────────────
#  متغیرهای محیطی «خانه وکلا»
#  این فایل الگوست. برای توسعهٔ محلی از آن یک کپی به نام `.env.local` بسازید.
#  همهٔ متغیرها اختیاری‌اند؛ مقادیر پیش‌فرض برای انتشار روی GitHub Pages تنظیم شده‌اند.
# ─────────────────────────────────────────────────────────────────────────────

# ─── آدرس انتشار ─────────────────────────────────────────────────────────────
# امروز: GitHub Pages روی زیرمسیر
NEXT_PUBLIC_SITE_ORIGIN=https://rahmaniho.github.io
NEXT_PUBLIC_BASE_PATH=/Vokalahome

# فردا: دامنهٔ اختصاصی روی ریشه — فقط این دو خط عوض می‌شوند، هیچ کدی تغییر نمی‌کند
# NEXT_PUBLIC_SITE_ORIGIN=https://vokalahome.com
# NEXT_PUBLIC_BASE_PATH=

# ─── ارسال فرم‌ها (اختیاری) ──────────────────────────────────────────────────
# تا وقتی این مقدار تنظیم نشده، فرم‌ها به‌صورت خودکار به واتساپ برمی‌گردند
# و هیچ اطلاعاتی گم نمی‌شود. راهنما: docs/BACKEND-INTEGRATION.md
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
