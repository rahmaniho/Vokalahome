{
  "name": "vokalahome",
  "version": "2.0.0",
  "private": true,
  "description": "خانه وکلا — باشگاه تخصصی و کافهٔ حقوقی وکلا در قزوین. سایت استاتیک، RTL و PWA برای GitHub Pages.",
  "scripts": {
    "dev": "npm run prebuild && next dev",
    "prebuild": "node scripts/prebuild.mjs && node scripts/optimize-images.mjs --if-needed",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "brand": "node scripts/generate-brand-assets.mjs",
    "images": "node scripts/optimize-images.mjs",
    "preview": "node scripts/serve-out.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "check": "npm run prebuild && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jalaali-js": "^1.2.8",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.31",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
